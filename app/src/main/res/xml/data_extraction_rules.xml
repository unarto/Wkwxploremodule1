<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<!-- [Jalur Class]: app/src/main/res/xml/data_extraction_rules.xml -->
<!-- [Penjelasan]: Mengecualikan database privat dan MMKV store dari cloud backup dan device transfer untuk mencegah kebocoran data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="xplore_filemanager.db" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="xplore_filemanager.db" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
